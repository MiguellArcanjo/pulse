{
  "name": "@research/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "HackerBot desktop (Electron): janela do workspace com o servidor e o banco locais rodando dentro do app.",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/main.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.6.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  }
}
