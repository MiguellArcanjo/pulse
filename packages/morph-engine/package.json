{
  "name": "@morph/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Morph Engine: funções puras que validam e aplicam operações sobre a AppSpec (validação semântica, versões, diff, rollback). Sem banco, sem rede, sem IA.",
  "exports": {
